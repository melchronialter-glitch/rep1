# Long, independent secrets. Generate with: openssl rand -hex 32
PHONE_TOKEN=replace-with-phone-secret
MCP_TOKEN=replace-with-mcp-client-secret

PORT=8787
REQUEST_TIMEOUT_MS=15000
LINEAGE_FILE=.aster-runtime/rosytalk-lineage.jsonl

# Keep false. The supplied tunnel helper forwards the independent MCP bearer;
# never remove MCP authentication to make a tunnel or proxy connect.
MCP_ALLOW_UNAUTHENTICATED_LOCAL=false
