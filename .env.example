# =============================================================================
# CryptoBot environment configuration
# Copy to .env and fill in. Anything left blank is treated as not configured.
# =============================================================================

# ---- Postgres -------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=cryptobot
POSTGRES_PASSWORD=cryptobot
POSTGRES_DB=cryptobot

# ---- Redis ----------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ---- Anthropic (required for any analysis) -------------------------------
ANTHROPIC_API_KEY=

# ---- Telegram outbound (required for Phase A demo) -----------------------
# Create a bot via @BotFather, then create 4 channels/groups and add the bot
# as admin. Use @userinfobot to find chat IDs (negative numbers for channels).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_STRICT=
TELEGRAM_CHAT_MEDIUM=
TELEGRAM_CHAT_FIREHOSE=
TELEGRAM_CHAT_MACRO=
# Your personal DM chat ID for on-demand commands and personal alerts
TELEGRAM_CHAT_DM=

# ---- Logging --------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=false

# =============================================================================
# Below this line are NOT used in Phase A. Filled in during later phases.
# =============================================================================

# ---- Phase B: news + market data -----------------------------------------
CRYPTOPANIC_API_KEY=
NEWS_API_KEY=
# Binance symbols the price watcher streams (comma-separated, lowercase)
PRICE_SYMBOLS=btcusdt,ethusdt,solusdt,bnbusdt,xrpusdt,dogeusdt
# % move within the window that triggers a price-move alert
PRICE_MOVE_THRESHOLD_PCT=3.0
PRICE_MOVE_WINDOW_MIN=60

# ---- Phase C: chain watchers ---------------------------------------------
# pump.fun (PumpPortal WS) needs no key — always on.
HELIUS_API_KEY=
ALCHEMY_API_KEY=
# Websocket RPC for BSC (QuickNode free tier or any public WS endpoint)
BSC_WS_URL=
# pump.fun mints with a smaller creator buy-in are tier_hint "ignore"
PUMPFUN_MIN_INITIAL_BUY_SOL=1.0

# ---- Phase E: Telegram group listener (user account via Telethon) --------
# Get api_id + api_hash from https://my.telegram.org, then run:
#   cryptobot tg-login
TELEGRAM_USER_API_ID=
TELEGRAM_USER_API_HASH=
TELEGRAM_USER_PHONE=
TELEGRAM_SESSION_PATH=data/tg_user.session
# Comma-separated chat IDs and/or chat titles to listen to; empty = all chats
TG_WATCH_CHATS=

# ---- Phase E: X (Twitter) watcher -----------------------------------------
# Apify is tried first; TwitterAPI.io is the fallback. Either one works.
APIFY_API_TOKEN=
TWITTERAPI_IO_KEY=
X_WATCH_HANDLES=aeyakovenko,blknoiz06,theunipcs,MustStopMurad,frankdegods
X_POLL_INTERVAL_S=120

# ---- Phase E: Reddit (public JSON API, no key needed) ---------------------
REDDIT_SUBREDDITS=CryptoCurrency,solana,CryptoMoonShots
REDDIT_POLL_INTERVAL_S=300

# ---- Phase E: translation (ZH/KO/RU/JA → EN via Claude Haiku) -------------
TRANSLATION_ENABLED=true

# ---- Email (optional, used from Phase B for digests) --------------------
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_FROM=
EMAIL_TO=
